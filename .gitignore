# Imminent Desync — Unity .gitignore
# Based on GitHub's Unity template, plus local editor, OS, and secret-file rules.

# ---- Unity generated folders ----
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/UIElementsSchema/
/.utmp/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Generated by Rider / VS Tools for Unity
/[Aa]ssets/Plugins/Editor/JetBrains*
/[Aa]ssets/[Pp]lugins/[Ee]ditor/[Jj]et[Bb]rains*

# Addressables / StreamingAssets build output
/[Aa]ssets/[Ss]treaming[Aa]ssets/aa/*
/[Aa]ssets/[Ss]treaming[Aa]ssets/aa.meta

# ---- IDE / solution files (Unity regenerates these) ----
.vs/
.idea/
.vscode/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---- Unity crash reports / diagnostics ----
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# ---- Builds and packages ----
*.apk
*.aab
*.ipa
*.app
*.unitypackage
*.unitypackage.meta

# ---- Secrets and signing material (never commit) ----
.env
.env.*
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
*.p8
*.mobileprovision
*.cer
*.certSigningRequest

# ---- Claude Code local-only settings ----
.claude/settings.local.json
CLAUDE.local.md

# ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini
